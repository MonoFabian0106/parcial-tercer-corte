# Copia este archivo a .env.local y rellena los valores reales (NO commitear .env.local)

# AWS
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3 Buckets (sustituye xx por tus iniciales)
S3_BUCKET_RAW=shopstream-raw-xx
S3_BUCKET_PROCESSED=shopstream-processed-xx
S3_BUCKET_QUARANTINE=shopstream-quarantine-xx
S3_BUCKET_ZAPPA=shopstream-zappa-deploys-xx

# RDS Postgres (Data Warehouse)
DB_HOST=
DB_PORT=5432
DB_NAME=shopstream_dwh
DB_USER=shopstream_admin
DB_PASSWORD=

# Generador de datos
GENERATOR_SEED=42
EVENTS_PER_DAY=800000

# CloudWatch
CLOUDWATCH_NAMESPACE=ShopStream/Ingest

# SNS Alerts
SNS_ALERT_TOPIC_ARN=
